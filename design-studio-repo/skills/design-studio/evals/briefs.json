{
  "version": 1,
  "purpose": "Regression briefs for universal-design-studio. Run the skill against each brief, judge with rubric.md, and record scores per model/skill version.",
  "briefs": [
    { "id": "mkt-saas", "domain": "marketing", "locales": ["en"],
      "prompt": "Landing page for a B2B API uptime monitoring tool for skeptical senior engineers.",
      "expect": { "dials": ["CRISP..BALANCED", "CALM..CRISP", "BALANCED"], "must": ["outcome headline", "no version labels", "single accent", "real/gen hero visual"] } },
    { "id": "mkt-smb-ur", "domain": "marketing", "locales": ["ur", "en"],
      "prompt": "Website for my bakery in Multan, Urdu and English, WhatsApp ordering.",
      "expect": { "dials": ["CRISP", "CALM..CRISP", "BALANCED"], "must": ["RTL logical properties", "Nastaliq/Naskh font coverage", "dir=rtl", "one accent locked", "Intl currency"] } },
    { "id": "mkt-luxury", "domain": "marketing", "locales": ["en", "fr"],
      "prompt": "Premium cookware brand launch, cinematic feel, paris atelier vibes.",
      "expect": { "must": ["NOT beige+brass+espresso default", "palette recorded to TASTE.md", "BALANCED motion with reduced fallback"] } },
    { "id": "prod-dashboard", "domain": "product-ui", "locales": ["en"],
      "prompt": "Analytics dashboard for an e-commerce ops team, dense, dark theme option.",
      "expect": { "dials": ["CALM..CRISP", "CALM", "BOLD"], "must": ["real DS or justified custom", "tabular-nums", "empty/loading/error states", "no marketing hero"] } },
    { "id": "prod-gov", "domain": "product-ui", "locales": ["en", "ur"],
      "prompt": "Citizen permit application portal, elderly users, accessibility-first.",
      "expect": { "dials": ["CALM", "CALM", "BALANCED"], "must": ["quiet constraints override vibe", "govuk/uswds-style system reach", "form errors plain-language"] } },
    { "id": "edit-docs", "domain": "editorial", "locales": ["en"],
      "prompt": "Docs site for an open-source CLI, search-first, great code blocks.",
      "expect": { "must": ["65ch measure", "TOC scroll-spy keyboard-ok", "single h1 per page", "docs nav tree"] } },
    { "id": "comm-store", "domain": "commerce", "locales": ["en", "ar"],
      "prompt": "Skincare store: catalog, product page, checkout. Arabic and English.",
      "expect": { "must": ["RTL mirrored checkout", "Intl currencies", "no fake urgency", "guest checkout first"] } },
    { "id": "mob-food-ur", "domain": "mobile", "locales": ["ur", "en"],
      "prompt": "Food delivery app home + restaurant + cart screens for Pakistan.",
      "expect": { "must": ["44pt targets", "safe areas", "RTL mirroring incl. chevrons", "skeleton rows", "thumb-zone cart CTA"] } },
    { "id": "mob-fintech", "domain": "mobile", "locales": ["en"],
      "prompt": "Mobile banking dashboard and transfer flow, trust-first.",
      "expect": { "must": ["CALM motion", "biometric prompt state", "error recovery copy", "no playful visuals"] } },
    { "id": "m2-onefile", "domain": "marketing", "locales": ["en", "ja"],
      "prompt": "One HTML file, portfolio for a Tokyo photographer, minimal, bilingual EN/JA.",
      "expect": { "mode": "M2", "must": ["no build step", "CJK line-height", "runs on file://", "B&W photo slots"] } },
    { "id": "redesign-blog", "domain": "editorial", "locales": ["en"],
      "prompt": "Redesign this existing blog (URL/repo) to feel modern; do not lose our SEO.",
      "expect": { "mode": "M4", "must": ["audit first", "slugs preserved or redirects mapped", "dial reading of current site", "modernization levers in order"] } },
    { "id": "wp-restaurant", "domain": "marketing", "locales": ["en", "ar"],
      "prompt": "WordPress block patterns for a restaurant: hero, menu highlights, hours, map.",
      "expect": { "stack": "wordpress", "must": ["theme.json tokens", "editor-safe blocks", "RTL-ready patterns"] } }
  ]
}
